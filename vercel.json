{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "sveltekit",
  "outputDirectory": "build",
  "installCommand": "./scripts/vercel-install.sh",
  "buildCommand": "npm run build-resume && npm run build",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Chun-Yu-Echo-Shih-Software-Engineer.pdf\""
        }
      ]
    }
  ]
}
