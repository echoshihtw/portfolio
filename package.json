{
  "name": "first-portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build-resume": "tsc --ignoreConfig --types node --strict false --pretty false --target ES2020 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck --rootDir . --outDir .resume-build scripts/buildResume.ts && node .resume-build/scripts/buildResume.js && node -e \"require('fs').rmSync('.resume-build',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "verify": "npm run lint && npm run check && npm test",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "build-icons": "tsx scripts/buildIcons.ts",
    "build-paintings": "tsx scripts/buildPaintings.ts",
    "audit:a11y": "node scripts/auditAccessibility.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@echoshihtw/clio-brand": "^1.4.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify/svelte": "^5.2.4",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^20.12.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "semantic-release": "^25.0.9",
    "sirv-cli": "^3.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^13.0.2",
    "mdsvex": "^0.12.8"
  }
}
