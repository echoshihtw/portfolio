{
  "name": "first-portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build-resume": "tsc --pretty false --target ES2020 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck --rootDir . --outDir .resume-build scripts/buildResume.ts && node .resume-build/scripts/buildResume.js && node -e \"require('fs').rmSync('.resume-build',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "build-icons": "tsx scripts/buildIcons.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/svelte": "^3.1.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.0.4",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "^20.12.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.30.0",
    "postcss": "^8.4.38",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "svelte-preprocess": "^5.1.3",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.2.7",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "dependencies": {
    "@tsparticles/svelte": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^13.0.2",
    "mdsvex": "^0.12.8",
    "tsparticles": "^4.3.2"
  }
}
